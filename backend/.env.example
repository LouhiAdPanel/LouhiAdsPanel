# Kopioi tämä tiedostoksi .env ja vaihda salasana omaksesi.
# Muoto: postgresql://KÄYTTÄJÄ:SALASANA@PALVELIN:PORTTI/TIETOKANTA
DATABASE_URL=postgresql://postgres:SALASANA@localhost:5432/louhiads

# Sallitut originit (pilkulla erotettuna). * = kaikki – vain kehitykseen.
CORS_ORIGINS=*

# Kirjautuminen
SESSION_HOURS=8          # kuinka kauan kirjautuminen on voimassa
MIN_PASSWORD_LENGTH=6    # salasanan vähimmäispituus
COOKIE_SECURE=false      # true, kun palvelin on HTTPS:n takana (tuotanto)
